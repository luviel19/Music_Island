{
  "name": "music-island",
  "version": "0.2.13",
  "description": "Free open-source Dynamic Island music player for Windows: Spotify, Yandex Music, YouTube, SoundCloud and system player",
  "homepage": "https://luviel19.github.io/Music_Island/",
  "repository": { "type": "git", "url": "git+https://github.com/luviel19/Music_Island.git" },
  "bugs": { "url": "https://github.com/luviel19/Music_Island/issues" },
  "keywords": ["dynamic-island", "windows", "spotify", "music-player", "desktop-widget", "electron", "yandex-music", "soundcloud", "youtube"],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run build:spotify && electron-builder --win nsis",
    "pack": "electron-builder --win --dir",
    "test": "node --test",
    "build:spotify": "powershell -NoProfile -ExecutionPolicy Bypass -File native/spotify-host/build.ps1"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "author": "luviel19",
  "build": {
    "appId": "com.luviel.musicisland",
    "productName": "Music Island",
    "artifactName": "Music-Island-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "security.js",
      "lyrics.js",
      "updater.js",
      "tunnel.js",
      "builtin-proxy.json",
      "providers/**/*",
      "src/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/tray.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/hysteria.exe",
        "to": "bin/hysteria.exe"
      },
      {
        "from": "bin/spotify-host",
        "to": "bin/spotify-host"
      }
    ],
    "asarUnpack": [
      "providers/media.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music Island",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "language": "1049"
    }
  }
}
